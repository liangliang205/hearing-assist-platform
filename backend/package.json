{
  "name": "hearing-assist-backend",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "dev": "dotenv -e ../.env -- next dev",
    "build": "dotenv -e ../.env -- next build",
    "start": "dotenv -e ../.env -- next start",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test src/lib/audiogram.test.ts",
    "db:generate": "dotenv -e ../.env -- prisma generate",
    "db:migrate": "dotenv -e ../.env -- prisma migrate dev --name init"
  },
  "dependencies": {
    "@prisma/client": "^6.1.0",
    "bcryptjs": "^3.0.3",
    "jose": "^6.2.15",
    "next": "^15.1.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "@types/react": "^19.0.3",
    "@types/react-dom": "^19.0.2",
    "dotenv-cli": "^8.0.0",
    "prisma": "^6.1.0",
    "tsx": "^4.23.15",
    "typescript": "^5.7.2"
  }
}
