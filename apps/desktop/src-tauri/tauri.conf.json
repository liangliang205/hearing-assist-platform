{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "HearLink",
  "version": "0.1.0",
  "identifier": "cn.edu.lingnan.hearlink",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "HearLink · 听力辅助平台",
        "width": 1280,
        "height": 860,
        "minWidth": 1024,
        "minHeight": 680,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "externalBin": ["binaries/hearlink-audio"],
    "shortDescription": "听障辅助视频处理及听力自测平台",
    "longDescription": "HearLink：按个人听力曲线处理系统所有声音的桌面端（虚拟声卡 + 自研 DSP 引擎）。"
  }
}
